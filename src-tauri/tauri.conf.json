{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "videolecture2notes",
  "version": "0.12.1",
  "identifier": "com.saitomtech.videolecture2notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Video Lecture to Notes",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME",
          "$HOME/**/*",
          "$APPLOCALDATA/projects",
          "$APPLOCALDATA/projects/**/*",
          "/Volumes",
          "/Volumes/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli",
      "binaries/llama-server",
      "binaries/apple-vision-ocr",
      "binaries/apple-speech-transcriber",
      "binaries/apple-foundation-models",
      "binaries/yt-dlp"
    ],
    "resources": {
      "binaries/llama-runtime": "llama-runtime",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QzAzMjZEQ0M2MDhGNUYKUldSZmoyRE1iVExBZG5zS1lQcjlWUkZaQ2oxOE9zUVdzMFlLRUh3N0kydFByWEwrQnlWdy9oY0QK",
      "endpoints": [
        "https://github.com/SaitomTech/VideoLecture2Notes/releases/latest/download/latest.json"
      ]
    }
  }
}
