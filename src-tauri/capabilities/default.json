{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**/*" },
        { "path": "/Volumes" },
        { "path": "/Volumes/**/*" }
      ]
    }
  ]
}
